# ---------- General
ENVIRONMENT=development            # development | production
FRONTEND_URL=http://localhost:5173 # used in OAuth redirects and offer-letter links
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# ---------- MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_attend

# ---------- Security (generate fresh values — see docs/DEPLOYMENT.md)
# python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
REDIS_URL=                          # optional, e.g. redis://localhost:6379/0 (shared rate limits)

# ---------- File storage
STORAGE_BACKEND=local               # local | s3
MAX_UPLOAD_MB=15
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ---------- AI assistant (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Email integration (OAuth apps you register)
# Google Cloud console -> OAuth client (Web). Redirect URI: {BACKEND_URL}/api/v1/email/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure portal -> App registration. Redirect URI: {BACKEND_URL}/api/v1/email/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
